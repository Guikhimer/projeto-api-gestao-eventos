NODE_ENV=development
PORT=5000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=sua_senha_do_mysql
DB_NAME=loja
DB_SSL=false
# No Aiven, copie o certificado CA e substitua as quebras de linha por \n.
DB_SSL_CA=
JWT_SECRET=troque_por_uma_chave_longa_e_aleatoria
# Em produção, informe a URL pública do serviço, sem barra final.
APP_URL=https://sua-api.onrender.com
# Origem do front-end autorizada; aceite múltiplas origens separadas por vírgula.
CORS_ORIGIN=http://localhost:3000
